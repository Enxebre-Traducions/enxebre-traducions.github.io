{{- /* Só os xogos novos, non as súas actualizacións nin as páxinas soltas: a data é a da ficha */ -}}
{{- $xogos := (where site.RegularPages "Section" "xogos").ByDate.Reverse -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.Title }}: xogos novos en galego</title>
    <link>{{ site.Home.Permalink }}</link>
    <description>Un aviso cada vez que sae a tradución dun xogo novo. Ti pos o xogo, nós o galego.</description>
    <language>gl</language>
    {{- with $xogos }}
    <lastBuildDate>{{ (index . 0).Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}
    {{- with .OutputFormats.Get "rss" }}
    <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />
    {{- end }}
    {{- range $xogos }}
    <item>
      <title>{{ .Title }}, en galego ({{ .Params.sistema }})</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ .Params.subtitulo }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
